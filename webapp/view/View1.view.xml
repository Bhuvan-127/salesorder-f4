<mvc:View
    controllerName="salesorder.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <SplitApp id="splitApp" initialDetail="detailPage" initialMaster="masterPage">
            
            <!-- ================== MASTER VIEW PANE (Left) ================== -->
            <masterPages>
                <Page 
                    id="masterPage" 
                    title="VA05 Sales Orders" 
                    class="sapUiStdPage" 
                    showNavButton="true" 
                    navButtonPress=".onNavBackPress">
                    <headerContent>
                        <Button icon="sap-icon://add" press=".onCreateOrder" type="Emphasized" tooltip="VA01 Create" text="Create" />
                    </headerContent>
                    <subHeader>
                        <Toolbar>
                            <SearchField liveChange=".onSearch" width="100%" placeholder="Search Orders, Customers, PO..." />
                        </Toolbar>
                    </subHeader>
                    <content>
                        <List 
                            id="orderList" 
                            items="{
                                path: '/SalesOrders',
                                parameters: {
                                    $expand: 'generalInfo,shippingRoute,billingFinancial,items,partners,pricingConditions,scheduleLines'
                                }
                            }" 
                            mode="SingleSelectMaster" 
                            selectionChange=".onOrderSelect">
                            <items>
                                <ObjectListItem
                                    title="Order #{salesOrder}"
                                    number="{
                                        parts: [{path: 'netValue'}],
                                        type: 'sap.ui.model.type.Float',
                                        formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}
                                    }"
                                    numberUnit="$"
                                    type="Active">
                                    <firstStatus>
                                        <ObjectStatus text="{status}" state="{= ${status} === 'Active Version' ? 'Success' : 'Warning' }" />
                                    </firstStatus>
                                    <attributes>
                                        <ObjectAttribute text="{generalInfo/soldToParty}" />
                                        <ObjectAttribute text="{generalInfo/docDate}" />
                                    </attributes>
                                </ObjectListItem>
                            </items>
                        </List>
                    </content>
                </Page>
            </masterPages>

            <!-- ================== DETAIL VIEW PANE (Right) ================== -->
            <detailPages>
                <Page 
                    id="detailPage" 
                    title="Manage Sales Orders (VA01 / VA05)">
                    <headerContent>
                        <Button 
                            text="{= ${viewModel>/simulatedLockUser} ? 'Simulate Lock: ACTIVE' : 'Simulate Lock: INACTIVE' }" 
                            type="{= ${viewModel>/simulatedLockUser} ? 'Reject' : 'Default' }"
                            icon="{= ${viewModel>/simulatedLockUser} ? 'sap-icon://locked' : 'sap-icon://unlocked' }" 
                            press=".onToggleLock" />
                    </headerContent>
                    <content>
                        
                        <!-- Empty State View -->
                        <VBox visible="{= !${viewModel>/activeOrder} }" alignItems="Center" justifyContent="Center" height="100%" class="sapUiMediumMarginTop">
                            <core:Icon src="sap-icon://sales-document" size="4rem" color="#cccccc" class="sapUiMediumMarginBottom"/>
                            <Title text="No Sales Document Selected" level="H3" class="sapUiSmallMarginBottom" />
                            <Text text="Select an order record from the Master list pane or trigger standard creation to initiate transaction mapping." />
                            <Button text="Launch VA01 Screen" press=".onCreateOrder" type="Emphasized" class="sapUiMediumMarginTop" />
                        </VBox>

                        <!-- Main Detail Content (Only when an order is active/selected) -->
                        <VBox visible="{= !!${viewModel>/activeOrder} }" class="sapUiContentPadding">
                            
                            <!-- High-Fidelity S/4HANA Detail Header Card (Row 1) -->
                            <HBox alignItems="Start" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMarginBottom">
                                <!-- Left Block: Document Details -->
                                <VBox class="sapUiTinyMarginTop">
                                    <HBox alignItems="Center">
                                        <Title text="Standard Order: {salesOrder}" titleStyle="H2" class="detailHeaderTitle" />
                                        <ObjectStatus text="{status}" state="{= ${status} === 'Active Version' ? 'Success' : 'Warning' }" class="detailHeaderStatusBadge sapUiSmallMarginBegin" />
                                    </HBox>
                                    <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                        <Text text="SOLD-TO CUSTOMER:" class="detailHeaderLabel" />
                                        <Text text="{generalInfo/soldToParty}" class="detailHeaderCustomerVal sapUiTinyMarginBegin" />
                                    </HBox>
                                </VBox>
                                
                                <!-- Right Block: KPI Card Widgets -->
                                <HBox class="detailKpiHBox" wrap="Wrap">
                                    <!-- Widget 1: Credit Limit Progress -->
                                    <VBox class="kpiCardBox sapUiTinyMargin" width="185px">
                                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                            <core:Icon src="sap-icon://credit-card" class="kpiCardIconBlue sapUiTinyMarginEnd" />
                                            <Text text="CREDIT LIMIT" class="kpiCardTitleBlue" />
                                        </HBox>
                                        <Text text="$125,000 of $500,000" class="kpiCardValue" />
                                        <ProgressIndicator percentValue="25" state="Success" displayValue="" class="kpiCardProgress" />
                                    </VBox>
                                    
                                    <!-- Widget 2: YTD Sales Volume -->
                                    <VBox class="kpiCardBox sapUiTinyMargin" width="185px">
                                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                            <core:Icon src="sap-icon://money-bills" class="kpiCardIconGreen sapUiTinyMarginEnd" />
                                            <Text text="YTD SALES VOL." class="kpiCardTitleGreen" />
                                        </HBox>
                                        <ObjectNumber number="320000" numberUnit="USD" class="kpiCardValueNum" />
                                        <Text text="Accumulated current fiscal" class="kpiCardSubtext" />
                                    </VBox>
                                </HBox>
                            </HBox>

                            <!-- Horizontal Key-Value Attribute Bar (Row 2) -->
                            <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="detailParametersHBox">
                                <!-- Col 1: PO Reference -->
                                <VBox class="sapUiMediumMarginEnd">
                                    <Text text="PURCHASE ORDER REF." class="row2Label" />
                                    <Text text="{generalInfo/poNumber}" class="row2Value" />
                                </VBox>
                                
                                <!-- Col 2: Document Date -->
                                <VBox class="sapUiMediumMarginEnd">
                                    <Text text="DOCUMENT DATE" class="row2Label" />
                                    <Text text="{generalInfo/docDate}" class="row2Value" />
                                </VBox>
                                
                                <!-- Col 3: Delivering Plant -->
                                <VBox class="sapUiMediumMarginEnd">
                                    <Text text="DELIVERING PLANT / DOCK" class="row2Label" />
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://shipping-status" class="row2ValueIcon sapUiTinyMarginEnd" />
                                        <Text text="{shippingRoute/shippingPoint}" class="row2ValueBlue" />
                                    </HBox>
                                </VBox>
                                
                                <!-- Col 4: Total Net Value -->
                                <VBox>
                                    <Text text="TOTAL NET DOCUMENT" class="row2Label" />
                                    <ObjectNumber 
                                        number="{
                                            parts: [{path: 'netValue'}],
                                            type: 'sap.ui.model.type.Float',
                                            formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}
                                        }" 
                                        numberUnit="$" 
                                        class="row2ValueGreen" />
                                </VBox>
                            </HBox>

                            <!-- ANCHOR-BAR TABS NAVIGATION SYSTEM -->
                            <IconTabBar id="idIconTabBar" class="sapUiResponsiveContentPadding">
                                <items>
                                    
                                    <!-- TAB 1: General Info -->
                                    <IconTabFilter text="General Info" key="general">
                                        <VBox spacing="1rem">
                                            <!-- Facet 1: General Header Details -->
                                            <f:SimpleForm 
                                                editable="{viewModel>/isEditing}" 
                                                layout="ColumnLayout" 
                                                columnsM="1" 
                                                columnsL="1" 
                                                title="General Header Details (VBAK and VBKD Structures)" 
                                                class="customFacetForm sapUiMediumMarginBottom">
                                                <f:content>
                                                    <Label text="SALES DOCUMENT TYPE:" class="formFacetLabel" />
                                                    <Input value="{generalInfo/orderType}" editable="false" class="formFacetInput" />
                                                    
                                                    <Label text="SALES ORGANIZATION:" class="formFacetLabel" />
                                                    <Input value="{generalInfo/salesOrg}" editable="false" class="formFacetInput" />
                                                    
                                                    <Label text="SOLD-TO PARTY (KUNNR):" class="formFacetLabel" />
                                                    <Input 
                                                        value="{generalInfo/soldToParty}" 
                                                        editable="{viewModel>/isEditing}" 
                                                        class="formFacetInput" />
                                                        
                                                    <Label text="SHIP-TO PARTY (WE):" class="formFacetLabel" />
                                                    <Input 
                                                        value="{generalInfo/shipToParty}" 
                                                        editable="{viewModel>/isEditing}" 
                                                        class="formFacetInput" />

                                                    <Label text="REQUESTED DELIVERY DATE (VDATU):" class="formFacetLabel" />
                                                    <DatePicker 
                                                        value="{generalInfo/reqDeliveryDate}" 
                                                        valueFormat="yyyy-MM-dd" 
                                                        editable="{viewModel>/isEditing}" 
                                                        class="formFacetInput" />

                                                    <Label text="CUSTOMER PURCHASE REF (BSTNK):" class="formFacetLabel" />
                                                    <Input value="{generalInfo/poNumber}" editable="{viewModel>/isEditing}" class="formFacetInput" />
                                                </f:content>
                                            </f:SimpleForm>

                                            <!-- Facet 2: Organizational Assignment -->
                                            <f:SimpleForm 
                                                editable="{viewModel>/isEditing}" 
                                                layout="ColumnLayout" 
                                                columnsM="1" 
                                                columnsL="1" 
                                                title="Organizational Assignment (VBAK)" 
                                                class="customFacetForm">
                                                <f:content>
                                                    <Label text="DISTRIBUTION CHANNEL:" class="formFacetLabel" />
                                                    <Input value="{generalInfo/distChannel}" editable="false" class="formFacetInput" />
                                                    
                                                    <Label text="DIVISION:" class="formFacetLabel" />
                                                    <Input value="{generalInfo/division}" editable="false" class="formFacetInput" />
                                                    
                                                    <Label text="SALES OFFICE:" class="formFacetLabel" />
                                                    <Input value="{generalInfo/salesOffice}" editable="false" class="formFacetInput" />
                                                    
                                                    <Label text="SALES GROUP:" class="formFacetLabel" />
                                                    <Input value="{generalInfo/salesGroup}" editable="false" class="formFacetInput" />

                                                    <Label text="DOCUMENT DATE:" class="formFacetLabel" />
                                                    <DatePicker value="{generalInfo/docDate}" valueFormat="yyyy-MM-dd" editable="false" class="formFacetInput" />

                                                    <Label text="PO DATE:" class="formFacetLabel" />
                                                    <DatePicker value="{generalInfo/poDate}" valueFormat="yyyy-MM-dd" editable="{viewModel>/isEditing}" class="formFacetInput" />
                                                </f:content>
                                            </f:SimpleForm>
                                        </VBox>
                                    </IconTabFilter>

                                    <!-- TAB 2: Line Items -->
                                    <IconTabFilter text="Line Items" key="items">
                                        <Table id="itemsTable" items="{items}">
                                            <headerToolbar>
                                                <OverflowToolbar>
                                                    <Title text="Sales Order Items" level="H2" class="customItemsTableTitle" />
                                                    <ToolbarSpacer />
                                                    <Button icon="sap-icon://add" text="Add Row" press=".onAddItem" visible="{viewModel>/isEditing}" class="customContinueBtn" />
                                                </OverflowToolbar>
                                            </headerToolbar>
                                            <columns>
                                                <Column width="4rem"><Text text="Item" class="tableColHeader" /></Column>
                                                <Column width="6rem"><Text text="Material" class="tableColHeader" /></Column>
                                                <Column width="10rem"><Text text="Description" class="tableColHeader" /></Column>
                                                <Column width="5rem"><Text text="Qty" class="tableColHeader" /></Column>
                                                <Column width="5rem"><Text text="UoM" class="tableColHeader" /></Column>
                                                <Column width="5rem"><Text text="Delivering Plant" class="tableColHeader" /></Column>
                                                <Column width="5rem"><Text text="Category" class="tableColHeader" /></Column>
                                                <Column width="7rem" hAlign="Right"><Text text="Net Value" class="tableColHeader" /></Column>
                                                <Column width="6rem" hAlign="Center"><Text text="Select" class="tableColHeader" /></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{itemNum}" class="tableCellText" />
                                                        <Input 
                                                            value="{material}" 
                                                            editable="{viewModel>/isEditing}" 
                                                            class="tableCellInput" />
                                                        <Text text="{description}" class="tableCellText" />
                                                        <Input 
                                                            value="{quantity}" 
                                                            type="Number" 
                                                            editable="{viewModel>/isEditing}" 
                                                            class="tableCellInputQty" />
                                                        <Text text="{uom}" class="tableCellText" />
                                                        <Input 
                                                            value="{plant}" 
                                                            editable="{viewModel>/isEditing}" 
                                                            class="tableCellInput" />
                                                        <Text text="{itemCategory}" class="tableCellText" />
                                                        <ObjectNumber number="{netValue}" numberUnit="USD" class="tableCellNetVal" />
                                                        <Button 
                                                            text="Conditions" 
                                                            press=".onSelectConditions"
                                                            class="customConditionsBtn" />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </IconTabFilter>

                                    <!-- TAB 3: Partner Functions -->
                                    <IconTabFilter text="Partner Functions"  key="partners">
                                        <Table items="{partners}">
                                            <columns>
                                                <Column width="5rem"><Text text="Role" /></Column>
                                                <Column width="10rem"><Text text="Description" /></Column>
                                                <Column width="8rem"><Text text="Partner ID" /></Column>
                                                <Column width="12rem"><Text text="Name" /></Column>
                                                <Column><Text text="Address" /></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{role}" />
                                                        <Text text="{description}" />
                                                        <Text text="{partnerId}" />
                                                        <Text text="{name}" />
                                                        <Text text="{address}" />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </IconTabFilter>

                                    <!-- TAB 4: Pricing Conditions -->
                                    <IconTabFilter text="Pricing Conditions"  key="pricing">
                                        <VBox spacing="6px">
                                            <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                                                <Label text="Select Pricing Item:" class="sapUiTinyMarginEnd" design="Bold" />
                                                <Select 
                                                    id="pricingItemSelect" 
                                                    items="{items}" 
                                                    selectedKey="{viewModel>/selectedLineItemIndex}">
                                                    <core:Item key="{itemNum}" text="Item {itemNum} - {material} ({description})" />
                                                </Select>
                                            </HBox>

                                            <!-- Manual Pricing Conditions Override Fields (Only when editing) -->
                                            <f:SimpleForm editable="true" layout="ColumnLayout" title="Manual Overrides for Selected Item" visible="{viewModel>/isEditing}">
                                                <f:content>
                                                    <Label text="Base Price (PR00)" />
                                                    <Input 
                                                        value="{viewModel>/manualPrice}" 
                                                        type="Number" 
                                                        placeholder="Override Base Price..." />
                                                    
                                                    <Label text="Customer Discount (K007 %)" />
                                                    <Input 
                                                        value="{viewModel>/manualDiscount}" 
                                                        type="Number" 
                                                        placeholder="Override Discount %..." />

                                                    <Label text="Freight Surcharge (KF00)" />
                                                    <Input 
                                                        value="{viewModel>/manualFreight}" 
                                                        type="Number" 
                                                        placeholder="Override Freight..." />
                                                </f:content>
                                            </f:SimpleForm>

                                            <Table items="{pricingConditions}">
                                                <headerToolbar>
                                                    <OverflowToolbar>
                                                        <Title text="RVAA01 Pricing Procedure Logic" level="H2"/>
                                                    </OverflowToolbar>
                                                </headerToolbar>
                                                <columns>
                                                    <Column width="4rem"><Text text="Step" /></Column>
                                                    <Column width="6rem"><Text text="Cond. Type" /></Column>
                                                    <Column><Text text="Description" /></Column>
                                                    <Column width="8rem" hAlign="Right"><Text text="Rate" /></Column>
                                                    <Column width="8rem" hAlign="Right"><Text text="Base Value" /></Column>
                                                    <Column width="8rem" hAlign="Right"><Text text="Calculated Value" /></Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem>
                                                        <cells>
                                                            <Text text="{step}" />
                                                            <Text text="{conditionType}" />
                                                            <Text text="{description}" />
                                                            <Text text="{rate}" />
                                                            <Text text="{baseValue}" />
                                                            <ObjectNumber number="{calculatedValue}" numberUnit="USD" />
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </VBox>
                                    </IconTabFilter>

                                    <!-- TAB 5: Schedule Lines (ATP split engine) -->
                                    <IconTabFilter text="Schedule Lines"  key="schedule">
                                        <Table items="{scheduleLines}">
                                            <headerToolbar>
                                                <OverflowToolbar>
                                                    <Title text="S/4HANA ATP Availability Control Split" level="H2"/>
                                                </OverflowToolbar>
                                            </headerToolbar>
                                            <columns>
                                                <Column width="4rem"><Text text="Item" /></Column>
                                                <Column width="4rem"><Text text="Line" /></Column>
                                                <Column width="10rem"><Text text="Delivery Date" /></Column>
                                                <Column width="6rem"><Text text="Category" /></Column>
                                                <Column width="8rem" hAlign="Right"><Text text="Order Qty" /></Column>
                                                <Column width="8rem" hAlign="Right"><Text text="Confirmed Qty" /></Column>
                                                <Column width="6rem" hAlign="Center"><Text text="Mov. Type" /></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{itemNum}" />
                                                        <Text text="{line}" />
                                                        <Text text="{deliveryDate}" />
                                                        <Text text="{category}" />
                                                        <Text text="{orderQuantity}" />
                                                        <Text text="{confirmedQuantity}" style="font-weight: bold; color: green;" />
                                                        <Text text="{movementType}" />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </IconTabFilter>

                                    <!-- TAB 6: Shipping & Route -->
                                    <IconTabFilter text="Shipping &amp; Route" key="shipping">
                                        <VBox spacing="1rem">
                                            <f:SimpleForm 
                                                editable="{viewModel>/isEditing}" 
                                                layout="ColumnLayout" 
                                                title="Shipping Logistics &amp; Dock Assignment (VBKD &amp; VSTEL)">
                                                <f:content>
                                                    <Label text="SHIPPING CONDITIONS (VSBED):" />
                                                    <Input value="{shippingRoute/shippingConditions}" editable="{viewModel>/isEditing}" />

                                                    <Label text="LOADING GROUP DEFAULT:" />
                                                    <Input value="{shippingRoute/loadingGroup}" editable="false" />

                                                    <Label text="SHIPPING POINT DETERMINED (VSTEL):" />
                                                    <Input value="{shippingRoute/shippingPoint}" editable="false" />

                                                    <Label text="LOGISTICS ROUTE ASSIGNMENT:" />
                                                    <Input value="{shippingRoute/route}" editable="false" />
                                                </f:content>
                                            </f:SimpleForm>

                                            <!-- Standard SAP Fiori Message Box (MessageStrip) -->
                                            <MessageStrip
                                                text="Determinator Formula Output: The Shipping Point code is dynamic: f(Shipping Conditions, Loading Group, Delivering Plant). Changing the dispatch terms to 'Express' or routing through alternate manufacturing sites updates delivery locks immediately."
                                                type="Information"
                                                showIcon="true"
                                                showCloseButton="false"
                                                class="sapUiMediumMarginTop" />
                                        </VBox>
                                    </IconTabFilter>

                                    <!-- TAB 7: Billing & Financial -->
                                    <IconTabFilter text="Billing &amp; Financial" key="billing">
                                        <f:SimpleForm 
                                            editable="{viewModel>/isEditing}" 
                                            layout="ColumnLayout" 
                                            columnsM="1" 
                                            columnsL="1" 
                                            title="BILLING TERMS &amp; ACCOUNTING INTEGRATIONS (VBKD STRUCTURE)"
                                            class="customFacetForm">
                                            <f:content>
                                                <Label text="PAYMENT TERMS (ZTERM):" class="formFacetLabel" />
                                                <Input value="{billingFinancial/paymentTerms}" editable="{viewModel>/isEditing}" class="formFacetInput" />

                                                <Label text="HEADER BILLING BLOCK (FAKSK):" class="formFacetLabel" />
                                                <Input value="{billingFinancial/billingBlock}" editable="{viewModel>/isEditing}" class="formFacetInput" />

                                                <Label text="DOCUMENT CURRENCY (WAERK):" class="formFacetLabel" />
                                                <Input value="{billingFinancial/docCurrency}" editable="false" class="formFacetInput" />

                                                <Label text="HEADER DELIVERY BLOCK (LIFSK):" class="formFacetLabel" />
                                                <Input value="{billingFinancial/deliveryBlock}" editable="{viewModel>/isEditing}" class="formFacetInput" />

                                                <Label text="MATERIAL TAX CLASSIFICATION (TAXM1):" class="formFacetLabel" />
                                                <Input value="{= ${billingFinancial/taxClass} === '0' ? '0 (Tax Exempt)' : '1 (Fully Taxable VAT 19%)' }" editable="false" class="formFacetInput" />
                                            </f:content>
                                        </f:SimpleForm>
                                    </IconTabFilter>

                                </items>
                            </IconTabBar>

                            <!-- VBFA Document Flow Process Section -->
                            <VBox class="sapUiMediumMarginTop customDocFlowBox">
                                <!-- Title Header Bar -->
                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="docFlowHeaderBar sapUiTinyMarginBottom">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://workflow-tasks" class="docFlowHeaderIcon sapUiTinyMarginEnd" style="color: #0070f2; font-size: 1.25rem;" />
                                        <Title text="VBFA Document Flow Process" titleStyle="H4" class="docFlowHeaderTitle" />
                                    </HBox>
                                    <Button text="Trace Keys" press=".onTraceKeys" class="customTraceKeysBtn" />
                                </HBox>
                                
                                <!-- Flow Nodes Container -->
                                <HBox alignItems="Center" wrap="Wrap" class="docFlowNodesContainer sapUiTinyMarginTop">
                                    <!-- Card 1: Standard Order -->
                                    <HBox alignItems="Center" class="docFlowNodeBox">
                                        <HBox alignItems="Center">
                                            <core:Icon src="sap-icon://sales-document" class="sapUiTinyMarginEnd" style="color: #0070f2; font-size: 1.25rem;" />
                                            <VBox>
                                                <Text text="STANDARD ORDER" class="docFlowNodeLabel" />
                                                <Link text="SO #{salesOrder}" press=".onSalesOrderLinkPress" class="docFlowNodeValBlue" />
                                            </VBox>
                                        </HBox>
                                        <core:Icon src="sap-icon://sys-enter-2" class="docFlowNodeStatusIconSuccess" />
                                    </HBox>
                                    
                                    <!-- Separator 1 -->
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="docFlowSeparatorIcon" />
                                    
                                    <!-- Card 2: Outbound Delivery -->
                                    <HBox alignItems="Center" class="docFlowNodeBox">
                                        <HBox alignItems="Center">
                                            <core:Icon src="sap-icon://shipping-status" class="sapUiTinyMarginEnd" style="color: #475569; font-size: 1.25rem;" />
                                            <VBox>
                                                <Text text="OUTBOUND DELIVERY" class="docFlowNodeLabel" />
                                                <Text text="DLV #80001294" class="docFlowNodeVal" />
                                            </VBox>
                                        </HBox>
                                        <core:Icon src="sap-icon://sys-enter-2" class="docFlowNodeStatusIconSuccess" />
                                    </HBox>
                                    
                                    <!-- Separator 2 -->
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="docFlowSeparatorIcon" />
                                    
                                    <!-- Card 3: Billing Document -->
                                    <HBox alignItems="Center" class="docFlowNodeBox">
                                        <HBox alignItems="Center">
                                            <core:Icon src="sap-icon://sales-notification" class="sapUiTinyMarginEnd" style="color: #475569; font-size: 1.25rem;" />
                                            <VBox>
                                                <Text text="BILLING DOCUMENT" class="docFlowNodeLabel" />
                                                <Text text="INV #90042851" class="docFlowNodeVal" />
                                            </VBox>
                                        </HBox>
                                        <core:Icon src="sap-icon://sys-enter-2" class="docFlowNodeStatusIconSuccess" />
                                    </HBox>
                                    
                                    <!-- Separator 3 -->
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="docFlowSeparatorIcon" />
                                    
                                    <!-- Card 4: Universal Journal GL -->
                                    <HBox alignItems="Center" class="docFlowNodeBox">
                                        <HBox alignItems="Center">
                                            <core:Icon src="sap-icon://accounting-document-verification" class="sapUiTinyMarginEnd" style="color: #10b981; font-size: 1.25rem;" />
                                            <VBox>
                                                <Text text="UNIVERSAL JOURNAL GL" class="docFlowNodeLabel" />
                                                <Link text="ACDOCA #1000293" press=".onAcdocaLinkPress" class="docFlowNodeValGreen" />
                                            </VBox>
                                        </HBox>
                                        <core:Icon src="sap-icon://sys-enter-2" class="docFlowNodeStatusIconSuccess" />
                                    </HBox>
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                    <footer>
                        <OverflowToolbar visible="{= !!${viewModel>/activeOrder} }">
                            <Button icon="sap-icon://message-popup" text="Message Log" type="Transparent" press=".onShowMessageLog" />
                            <ToolbarSpacer />
                            <Button text="Discard Draft" press=".onDiscardDraft" visible="{viewModel>/isEditing}" type="Transparent" />
                            <Button text="Save Order" press=".onSaveOrder" visible="{viewModel>/isEditing}" type="Emphasized" />
                            <Button text="Delete Document" press=".onDeleteOrder" visible="{= !${viewModel>/isEditing} }" class="customDeleteBtn" />
                            <Button text="Edit Sales Order" icon="sap-icon://edit" press=".onEditOrder" visible="{= !${viewModel>/isEditing} }" type="Emphasized" class="customEditBtn" />
                        </OverflowToolbar>
                    </footer>
                </Page>
            </detailPages>
